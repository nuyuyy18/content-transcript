# YouTube Content Transcription System — Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (for Whisper STT & GPT religious content detection)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# Optional: Quran API (alquran.cloud is free, no key needed)
# QURAN_API_URL=https://api.alquran.cloud/v1

# Processing Configuration
MAX_RETRIES=3
CONCURRENCY_LIMIT=3

# Output directory (relative to project root)
OUTPUT_DIR=result
